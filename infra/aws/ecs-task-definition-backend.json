{
  "family": "ghostshift-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ghostshift-ecs-execution",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ghostshift-ecs-task",
  "containerDefinitions": [
    {
      "name": "ghostshift-backend",
      "image": "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/ghostshift/backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "DEBUG", "value": "false" },
        { "name": "LOG_LEVEL", "value": "INFO" },
        { "name": "PORT", "value": "8000" },
        { "name": "HOST", "value": "0.0.0.0" },
        { "name": "CORS_ORIGINS", "value": "https://app.ghostshift.com" }
      ],
      "secrets": [
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:ghostshift/prod-JWT_SECRET" },
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:ghostshift/prod-DATABASE_URL" },
        { "name": "REDIS_URL", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:ghostshift/prod-REDIS_URL" },
        { "name": "OPENAI_API_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:ghostshift/prod-OPENAI_API_KEY" },
        { "name": "AWS_ACCESS_KEY_ID", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:ghostshift/prod-AWS_ACCESS_KEY_ID" },
        { "name": "AWS_SECRET_ACCESS_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:ghostshift/prod-AWS_SECRET_ACCESS_KEY" },
        { "name": "AWS_S3_BUCKET", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:ghostshift/prod-S3_BUCKET" },
        { "name": "SMTP_HOST", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:ghostshift/prod-SMTP_HOST" },
        { "name": "SMTP_USER", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:ghostshift/prod-SMTP_USER" },
        { "name": "SMTP_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:ghostshift/prod-SMTP_PASSWORD" },
        { "name": "SMTP_FROM", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:ghostshift/prod-SMTP_FROM" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ghostshift-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health').read()\" || exit 1"],
        "interval": 30,
        "timeout": 5,
        "startPeriod": 20,
        "retries": 3
      }
    }
  ]
}
